+const images: ImageItem[] = imageSources.map((source, index) => ({
+  source,
+  alt: content.images?.[index]?.alt ?? "",
+}));
+
+const columnImageCounts = [3, 3, 4, 3, 3];
+
+let startIndex = 0;
+const columns: ImageItem[][] = columnImageCounts.map((count) => {
+  const columnImages = images.slice(startIndex, startIndex + count);
+  startIndex += count;
+  return columnImages;
+});
+
+const remainingImages = images.slice(startIndex);
+if (remainingImages.length > 0) {
+  columns[columns.length - 1] = [
+    ...columns[columns.length - 1],
+    ...remainingImages,
+  ];
+}
+
+const columnOffsets = [
+  "lg:translate-y-14",
+  "lg:-translate-y-10",
+  "lg:translate-y-16",
+  "lg:-translate-y-12",
+  "lg:translate-y-10",
+];
+
+const imageWidths = [320, 480, 640, 768, 960];
+const imageSizes = "(min-width:1600px) 13vw, (min-width:1280px) 15vw, (min-width:768px) 30vw, 45vw";
+---
+
+<section class="w-full overflow-visible py-16 sm:py-20 lg:py-24">
+  <div class="mx-auto w-full max-w-none px-4 sm:px-6 lg:px-12 xl:px-16">
+    <div class="flex flex-col gap-4 text-primary-forest lg:hidden">
+      <h2 class="text-4xl sm:text-5xl font-bold text-primary-1">
+        {content.title}
+      </h2>
+    </div>
+
+    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:hidden">
+      {
+        images.map((image) => (
+          <div class="relative overflow-hidden rounded-[28px] shadow-lg shadow-black/10 ring-1 ring-primary-forest/10">
+            <Image
+              src={image.source}
+              alt={image.alt}
+              class="block h-auto w-full"
+              loading="lazy"
+              decoding="async"
+              widths={imageWidths}
+              sizes={imageSizes}
+            />
+          </div>
+        ))
+      }
+    </div>
+
+    <div class="hidden lg:flex w-full flex-nowrap justify-start gap-8 xl:gap-12">
+      <div class="flex w-60 flex-none items-start pt-8 xl:w-72">
+        <h2 class="text-4xl font-extrabold leading-tight text-primary-1 xl:text-5xl">
+          {content.title}
+        </h2>
+      </div>
+
+      {
+        columns.map((column, index) => (
+          <div
+            class:list={[
+              "flex w-48 flex-none flex-col gap-6 xl:w-56 xl:gap-8",
+              columnOffsets[index % columnOffsets.length],
+            ]}
+          >
+            {
+              column.map((image) => (
+                <div class="relative overflow-hidden rounded-[28px] shadow-lg shadow-black/15 ring-1 ring-primary-forest/10">
+                  <Image
+                    src={image.source}
+                    alt={image.alt}
+                    class="block h-auto w-full"
+                    loading="lazy"
+                    decoding="async"
+                    widths={imageWidths}
+                    sizes="(min-width:1600px) 12vw, (min-width:1280px) 14vw, 28vw"
