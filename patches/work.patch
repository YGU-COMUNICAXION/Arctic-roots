+                    <li class="relative pl-6">
+                      <span class="absolute left-0 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-white"></span>
+                      {item}
+                    </li>
+                  ))
+                }
+              </ul>
+            ))
+          }
+        </div>
+      )}
+    </div>
+  </div>
+</section>
