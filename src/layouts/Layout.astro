---
import { ClientRouter } from "astro:transitions";

import Header from "./Header.astro";
import Footer from "@components/Footer.astro";
import "../styles/global.css";

import type { UILang } from "@i18n/ui";
import BtnWhatsApp from "./BtnWhatsApp.astro";

type HeaderVariant = "light" | "dark";

interface Props {
  lang: UILang;
  headerVariant?: HeaderVariant;
}

const { lang, headerVariant = "light" }: Props = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Arctic Roots</title>

    <!-- Seo metadata -->
    <meta
      name="description"
      content="Explora Islandia y Groenlandia a tu manera. Islandia y Groenlandia no se visitan. Se recorren, se saborean, se sienten y nunca se olvidan."
    />
    <meta
      name="keywords"
      content="viajes, nórdicos, polares, agencia, turismo, aventura, naturaleza, cultura, Escandinavia, Islandia, Groenlandia, Laponia, fiordos, auroras boreales"
    />
    <meta name="author" content="YGU COMUNICAXION" />

    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header lang={lang} variant={headerVariant} />
    <main class="flex-1 bg-white">
      <slot />
    </main>
    <Footer lang={lang} />
    <BtnWhatsApp />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
