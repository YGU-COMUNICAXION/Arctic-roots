---
import Layout from "@layouts/Layout.astro";
import { getLangFromUrl } from "@i18n/utils";
import { ui } from "@i18n/ui";
import HeroBackground from "@assets/img/agente/hero.jpg";
import HeroBanner from "@components/HeroBanner.astro";
import BtnWhats from "@components/BtnWhats.astro";

const lang = getLangFromUrl(Astro.url);
const agentContent = ui[lang].agents;
---

<Layout lang={lang}>
  <HeroBanner
    backgroundImage={HeroBackground}
    align="left"
    activeBgOverlay={true}
  >
    <section class="w-full overflow-hidden mt-20">
      <div class="mx-auto flex w-full flex-col gap-8 lg:gap-20">
        <div class="grid lg:gap-24 text-white lg:grid-cols-2 lg:items-center">
          <div class="flex flex-col justify-center gap-6">
            <h1
              class="text-start text-2xl font-bold leading-tight md:text-3xl lg:text-4xl"
            >
              <span class="block">{agentContent.hero.titleLineOne}</span>
              <span class="block">{agentContent.hero.titleLineTwo}</span>
            </h1>
          </div>

          <div
            class="flex flex-col justify-center space-y-4
            font-light [&>p>strong]:font-bold
            text-sm md:text-base text-start leading-relaxed text-white/90 lg:text-lg"
            set:html={agentContent.hero.descriptionHtml}
          />
        </div>

        <div class="flex flex-col items-center gap-4 text-center text-white">
          <p class="text-lg font-medium md:text-xl">
            {agentContent.whatsappHeadline}
          </p>
          <BtnWhats />
        </div>
      </div>
    </section>
  </HeroBanner>
</Layout>
