---
import HeroBanner from "@components/HeroBanner.astro";
import Layout from "@layouts/Layout.astro";

import ContactHeroImage from "@assets/img/contacto/hero.jpg";

import { getLangFromUrl } from "@i18n/utils";
import { ui } from "@i18n/ui";
import BtnWhats from "@components/BtnWhats.astro";

const lang = getLangFromUrl(Astro.url);
const contactContent = ui[lang].contact;
---

<Layout lang={lang}>
  <HeroBanner backgroundImage={ContactHeroImage} activeBgOverlay={true}>
    <div class="mt-20 w-full">
      <div
        class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center text-white"
      >
        <h1 class="text-3xl font-normal leading-tight md:text-4xl lg:text-4xl">
          {contactContent.hero.title}
        </h1>
        <p
          class="text-base font-light text-white/90 md:text-lg lg:text-xl xl:text-2xl"
        >
          {contactContent.hero.description}
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <BtnWhats />
          <a
            href={contactContent.hero.testHref}
            class="inline-flex items-center justify-center gap-3 rounded-full border border-white/80 px-7 py-3 font-normal uppercase tracking-wide text-white transition-colors
            hover:-translate-y-0.5 hover:bg-white/10 focus-visible:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={contactContent.hero.testAriaLabel}
          >
            {contactContent.hero.testCta}
          </a>
        </div>
      </div>
    </div>
  </HeroBanner>
</Layout>
