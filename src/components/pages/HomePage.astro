---
import Layout from "@layouts/Layout.astro";
import HeroBanner from "@components/HeroBanner.astro";
import ArcticHighlights from "@components/home/ArcticHighlights.astro";
import HappyMemoriesGallery from "@components/home/HappyMemoriesGallery.astro";
import ContactCTA from "@components/home/ContactCTA.astro";
import IcelandTravel from "@components/home/IcelandTravel.astro";
import IslandsNationBanner from "@components/home/IslandsNationBanner.astro";
import TestimonialsSection from "@components/TestimonialsSection.astro";

import HeroImg from "@assets/img/home/hero.jpg";
import WaterfallBackground from "@assets/img/home/bgCascada.jpg";

import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeContent = ui[lang].home.highlights;
const islandsNationContent = ui[lang].home.islandsNation;
const memoriesContent = ui[lang].home.memories;
const contactCtaContent = ui[lang].home.contactCta;
const travelContent = ui[lang].home.travel;
const aboutContent = ui[lang].about;
---

<Layout lang={lang}>
  <HeroBanner backgroundImage={HeroImg}>
    <h1
      class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-4 text-primary-forest"
      data-i18n-key="hero.title"
    >
      {t("hero.title")}
    </h1>
    <p
      class="text-lg md:text-xl lg:text-2xl xl:text-3xl mb-8 text-primary-forest text-shadow-amber-100"
      data-i18n-key="hero.subtitle"
    >
      {t("hero.subtitle")}
    </p>
  </HeroBanner>

  <ArcticHighlights content={homeContent} />
  <IcelandTravel content={travelContent} />

  <IslandsNationBanner content={islandsNationContent} />
  <HappyMemoriesGallery content={memoriesContent} />

  <TestimonialsSection
    title={aboutContent.testimonials.title}
    subtitle={aboutContent.testimonials.subtitle}
    testimonials={aboutContent.testimonials.items.slice()}
    ctaLabel={aboutContent.testimonials.ctaLabel}
    backgroundImage={WaterfallBackground}
    backgroundAlt={aboutContent.testimonials.backgroundAlt}
  />
  <ContactCTA content={contactCtaContent} />
</Layout>
