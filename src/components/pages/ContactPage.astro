---
import Layout from "@layouts/Layout.astro";
import HeroBanner from "@components/HeroBanner.astro";

import ContactHeroImage from "@assets/img/contacto/hero.jpg";

import { getLangFromUrl } from "@i18n/utils";
import { ui } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const contactContent = ui[lang].contact;
---

<Layout lang={lang} headerVariant="dark">
  <HeroBanner backgroundImage={ContactHeroImage} activeBgOverlay={true}>
    <div class="mt-20 w-full">
      <div
        class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center text-white"
      >
        <h1 class="text-3xl font-normal leading-tight md:text-4xl lg:text-5xl">
          {contactContent.hero.title}
        </h1>
        <p
          class="text-base font-light text-white/90 md:text-lg lg:text-xl xl:text-2xl"
        >
          {contactContent.hero.description}
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href={contactContent.hero.whatsappHref}
            class="inline-flex items-center justify-center gap-3 rounded-full bg-primary-mist px-7 py-3 font-normal uppercase tracking-wide text-primary-forest shadow-lg shadow-black/20 transition-transform hover:-translate-y-0.5 focus-visible:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-100/70"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={contactContent.hero.whatsappAriaLabel}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path
                d="M12.04 2a9.93 9.93 0 0 0-8.5 14.92l-1.1 3.98a.75.75 0 0 0 .92.92l3.98-1.1A9.93 9.93 0 1 0 12.03 2Zm0 1.5a8.43 8.43 0 0 1 5.98 14.4.75.75 0 0 0-.2.32l-.72 2.6-2.6-.7a.75.75 0 0 0-.32.01 8.43 8.43 0 1 1-2.14-16.63Zm-3.05 3.94a.75.75 0 0 0-.63.4c-.34.6-1.02 1.93-.98 3.23.06 2.07 1.39 3.78 3.88 5.08 2.48 1.3 3.88 1.16 4.86.8.66-.23 1.65-.94 1.89-1.54.24-.6.24-1.12.17-1.24-.06-.12-.23-.19-.48-.33-.25-.14-1.46-.72-1.69-.81-.23-.09-.4-.14-.57.14-.17.28-.65.81-.8.98-.15.17-.3.19-.55.05-.25-.14-1.06-.39-2.01-1.2-.74-.66-1.24-1.48-1.39-1.73-.15-.25-.02-.38.11-.5.11-.11.25-.28.38-.42.13-.14.17-.23.26-.38.09-.15.05-.28-.02-.42-.07-.14-.57-1.36-.78-1.86-.2-.47-.41-.41-.57-.41Z"
              ></path>
            </svg>
            <span>{contactContent.hero.whatsappCta}</span>
          </a>
          <a
            href={contactContent.hero.testHref}
            class="inline-flex items-center justify-center gap-3 rounded-full border border-white/80 px-7 py-3 font-normal uppercase tracking-wide text-white transition-colors hover:bg-white/10 focus-visible:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={contactContent.hero.testAriaLabel}
          >
            {contactContent.hero.testCta}
          </a>
        </div>
      </div>
    </div>
  </HeroBanner>
</Layout>
