---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import Memory1 from "@assets/img/home/recuerdos/1.png";
import Memory2 from "@assets/img/home/recuerdos/2.png";
import Memory3 from "@assets/img/home/recuerdos/3.png";
import Memory4 from "@assets/img/home/recuerdos/4.png";
import Memory5 from "@assets/img/home/recuerdos/5.png";
import Memory6 from "@assets/img/home/recuerdos/6.png";
import Memory7 from "@assets/img/home/recuerdos/7.png";
import Memory8 from "@assets/img/home/recuerdos/8.png";
import Memory9 from "@assets/img/home/recuerdos/9.png";
import Memory10 from "@assets/img/home/recuerdos/10.png";
import Memory11 from "@assets/img/home/recuerdos/11.png";
import Memory12 from "@assets/img/home/recuerdos/12.png";
import Memory13 from "@assets/img/home/recuerdos/13.png";
import Memory14 from "@assets/img/home/recuerdos/14.png";
import Memory15 from "@assets/img/home/recuerdos/15.png";
import Memory16 from "@assets/img/home/recuerdos/16.png";

interface MemoriesContent {
  title: string;
  images: { alt: string }[];
}

interface ImageItem {
  source: ImageMetadata;
  alt: string;
}

const { content } = Astro.props as { content: MemoriesContent };

const imageSources: ImageMetadata[] = [
  Memory1,
  Memory2,
  Memory3,
  Memory4,
  Memory5,
  Memory6,
  Memory7,
  Memory8,
  Memory9,
  Memory10,
  Memory11,
  Memory12,
  Memory13,
  Memory14,
  Memory15,
  Memory16,
];

const images: ImageItem[] = imageSources.map((source, index) => ({
  source,
  alt: content.images?.[index]?.alt ?? "",
}));

const columnImageCounts = [3, 3, 4, 3, 3];

let startIndex = 0;
const columns: ImageItem[][] = columnImageCounts.map((count) => {
  const columnImages = images.slice(startIndex, startIndex + count);
  startIndex += count;
  return columnImages;
});

const remainingImages = images.slice(startIndex);
if (remainingImages.length > 0) {
  columns[columns.length - 1] = [
    ...columns[columns.length - 1],
    ...remainingImages,
  ];
}

const columnOffsets = [
  "lg:translate-y-14",
  "lg:-translate-y-10",
  "lg:translate-y-16",
  "lg:-translate-y-12",
  "lg:translate-y-10",
];

const imageWidths = [320, 480, 640, 768, 960];
const imageSizes = "(min-width:1280px) 14vw, (min-width:768px) 28vw, 45vw";
---

<section class="w-full overflow-hidden py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full px-4 sm:px-6 lg:px-10 xl:px-16">
    <div class="flex flex-col gap-4 text-primary-forest lg:hidden">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary-1">
        {content.title}
      </h2>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:hidden">
      {
        images.map((image) => (
          <div class="relative aspect-[3/4] overflow-hidden rounded-[28px] shadow-lg shadow-black/10 ring-1 ring-primary-forest/10">
            <Image
              src={image.source}
              alt={image.alt}
              class="h-full w-full object-cover"
              style="width: 100%; height: 100%;"
              loading="lazy"
              decoding="async"
              widths={imageWidths}
              sizes={imageSizes}
            />
          </div>
        ))
      }
    </div>

    <div class="hidden lg:flex w-full justify-center gap-6 xl:gap-10">
      <div class="flex w-56 flex-none items-start pt-12 xl:w-64">
        <h2 class="text-3xl xl:text-4xl font-bold leading-tight text-primary-1">
          {content.title}
        </h2>
      </div>

      {
        columns.map((column, index) => (
          <div
            class:list={[
              "flex w-48 flex-col gap-6 xl:w-56 xl:gap-8",
              columnOffsets[index % columnOffsets.length],
            ]}
          >
            {
              column.map((image) => (
                <div class="relative aspect-[3/4] overflow-hidden rounded-[28px] shadow-lg shadow-black/15 ring-1 ring-primary-forest/10">
                  <Image
                    src={image.source}
                    alt={image.alt}
                    class="h-full w-full object-cover"
                    style="width: 100%; height: 100%;"
                    loading="lazy"
                    decoding="async"
                    widths={imageWidths}
                    sizes="(min-width:1600px) 12vw, (min-width:1280px) 14vw, 28vw"
                  />
                </div>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>
</section>
