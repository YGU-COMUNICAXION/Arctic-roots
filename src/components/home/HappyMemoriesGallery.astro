---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import Memory1 from "@assets/img/home/recuerdos/1.png";
import Memory2 from "@assets/img/home/recuerdos/2.png";
import Memory3 from "@assets/img/home/recuerdos/3.png";
import Memory4 from "@assets/img/home/recuerdos/4.png";
import Memory5 from "@assets/img/home/recuerdos/5.png";
import Memory6 from "@assets/img/home/recuerdos/6.png";
import Memory7 from "@assets/img/home/recuerdos/7.png";
import Memory8 from "@assets/img/home/recuerdos/8.png";
import Memory9 from "@assets/img/home/recuerdos/9.png";
import Memory10 from "@assets/img/home/recuerdos/10.png";
import Memory11 from "@assets/img/home/recuerdos/11.png";
import Memory12 from "@assets/img/home/recuerdos/12.png";
import Memory13 from "@assets/img/home/recuerdos/13.png";
import Memory14 from "@assets/img/home/recuerdos/14.png";
import Memory15 from "@assets/img/home/recuerdos/15.png";
import Memory16 from "@assets/img/home/recuerdos/16.png";

interface MemoriesContent {
  title: string;
  description: string;
  images: { alt: string }[];
}

interface ImageItem {
  source: ImageMetadata;
  alt: string;
}

const { content } = Astro.props as { content: MemoriesContent };

const imageSources: ImageMetadata[] = [
  Memory1,
  Memory2,
  Memory3,
  Memory4,
  Memory5,
  Memory6,
  Memory7,
  Memory8,
  Memory9,
  Memory10,
  Memory11,
  Memory12,
  Memory13,
  Memory14,
  Memory15,
  Memory16,
];

const images: ImageItem[] = imageSources.map((source, index) => ({
  source,
  alt: content.images?.[index]?.alt ?? "",
}));

const columnImageCounts = [3, 3, 4, 3, 3];

let startIndex = 0;
const columns: ImageItem[][] = columnImageCounts.map((count) => {
  const columnImages = images.slice(startIndex, startIndex + count);
  startIndex += count;
  return columnImages;
});

const remainingImages = images.slice(startIndex);
if (remainingImages.length > 0) {
  columns[columns.length - 1] = [
    ...columns[columns.length - 1],
    ...remainingImages,
  ];
}

const columnOffsets = [
  "lg:translate-y-16",
  "lg:-translate-y-16",
  "lg:translate-y-16",
  "lg:-translate-y-16",
  "lg:translate-y-16",
];
---

<section class="w-full py-16 sm:py-20 lg:py-24">
  <div class="container mx-auto px-4">
    <div class="flex flex-col gap-10 lg:gap-14">
      <div class="flex flex-col gap-4 max-w-3xl text-primary-forest">
        <h2 class="text-3xl sm:text-4xl font-light">{content.title}</h2>
        <p class="text-base sm:text-lg lg:text-xl font-light leading-relaxed">
          {content.description}
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 lg:hidden">
        {
          images.map((image) => (
            <div class="aspect-[3/4]">
              <div class="h-full overflow-hidden rounded-3xl shadow-lg shadow-black/10 ring-1 ring-primary-forest/10">
                <Image
                  src={image.source}
                  alt={image.alt}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                  widths={[320, 480, 640, 768, 960]}
                  sizes="(min-width:1280px) 14vw, (min-width:768px) 28vw, 45vw"
                />
              </div>
            </div>
          ))
        }
      </div>

      <div class="hidden lg:flex justify-center gap-6 xl:gap-8">
        {
          columns.map((column, index) => (
            <div
              class:list={[
                "flex flex-col gap-6 xl:gap-8 w-48 xl:w-56",
                columnOffsets[index],
              ]}
            >
              {
                column.map((image) => (
                  <div class="aspect-[3/4]">
                    <div class="h-full overflow-hidden rounded-3xl shadow-lg shadow-black/10 ring-1 ring-primary-forest/10">
                      <Image
                        src={image.source}
                        alt={image.alt}
                        class="h-full w-full object-cover"
                        loading="lazy"
                        decoding="async"
                        widths={[320, 480, 640, 768, 960]}
                        sizes="(min-width:1280px) 14vw, (min-width:768px) 28vw, 45vw"
                      />
                    </div>
                  </div>
                ))
              }
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
