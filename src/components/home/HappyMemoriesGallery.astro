---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import Memory1 from "@assets/img/home/recuerdos/1.png";
import Memory2 from "@assets/img/home/recuerdos/2.png";
import Memory3 from "@assets/img/home/recuerdos/3.png";
import Memory4 from "@assets/img/home/recuerdos/4.png";
import Memory5 from "@assets/img/home/recuerdos/5.png";
import Memory6 from "@assets/img/home/recuerdos/6.png";
import Memory7 from "@assets/img/home/recuerdos/7.png";
import Memory8 from "@assets/img/home/recuerdos/8.png";
import Memory9 from "@assets/img/home/recuerdos/9.png";
import Memory10 from "@assets/img/home/recuerdos/10.png";
import Memory11 from "@assets/img/home/recuerdos/11.png";
import Memory12 from "@assets/img/home/recuerdos/12.png";
import Memory13 from "@assets/img/home/recuerdos/13.png";
import Memory14 from "@assets/img/home/recuerdos/14.png";
import Memory15 from "@assets/img/home/recuerdos/15.png";
import Memory16 from "@assets/img/home/recuerdos/16.png";

interface MemoriesContent {
  title: string;
  images: { alt: string }[];
}

interface ImageItem {
  source: ImageMetadata;
  alt: string;
  orientation: "portrait" | "landscape";
}

interface ColumnConfig {
  count: number;
  offset: string;
  includeTitle?: boolean;
}

interface ColumnData extends ColumnConfig {
  images: ImageItem[];
}

const { content } = Astro.props as { content: MemoriesContent };

const imageSources: ImageMetadata[] = [
  Memory1,
  Memory2,
  Memory3,
  Memory4,
  Memory5,
  Memory6,
  Memory7,
  Memory8,
  Memory9,
  Memory10,
  Memory11,
  Memory12,
  Memory13,
  Memory14,
  Memory15,
  Memory16,
];

const images: ImageItem[] = imageSources.map((source, index) => ({
  source,
  alt: content.images?.[index]?.alt ?? "",
  orientation: source.width >= source.height ? "landscape" : "portrait",
}));

const columnConfigs: ColumnConfig[] = [
  { count: 3, offset: "lg:translate-y-16" },
  { count: 3, offset: "lg:-translate-y-12", includeTitle: true },
  { count: 3, offset: "lg:translate-y-20" },
  { count: 3, offset: "lg:-translate-y-10" },
  { count: 4, offset: "lg:translate-y-12" },
];

let startIndex = 0;
const columns: ColumnData[] = columnConfigs.map((config) => {
  const columnImages = images.slice(startIndex, startIndex + config.count);
  startIndex += config.count;
  return {
    ...config,
    images: columnImages,
  };
});

const remainingImages = images.slice(startIndex);
if (remainingImages.length > 0) {
  const lastColumn = columns[columns.length - 1];
  columns[columns.length - 1] = {
    ...lastColumn,
    images: [...lastColumn.images, ...remainingImages],
  };
}

const imageWidths = [480, 640, 768, 960, 1280];
const imageSizes = "(min-width:1600px) 16vw, (min-width:1280px) 18vw, (min-width:1024px) 19vw, (min-width:768px) 30vw, 45vw";
---

<section class="w-full overflow-visible py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-none px-4 sm:px-6 lg:px-12 xl:px-16">
    <div class="flex flex-col gap-4 text-primary-forest lg:hidden">
      <h2 class="text-[28px] font-normal text-primary-1 sm:text-[32px]">
        {content.title}
      </h2>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:hidden">
      {
        images.map((image) => (
          <div
            class:list=[
              "relative overflow-hidden rounded-[28px] shadow-lg shadow-black/10 ring-1 ring-primary-forest/10",
              image.orientation === "portrait" ? "aspect-[3/4]" : "aspect-[4/3]",
            ]
          >
            <Image
              src={image.source}
              alt={image.alt}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
              widths={imageWidths}
              sizes={imageSizes}
            />
          </div>
        ))
      }
    </div>

    <div class="hidden lg:flex w-full flex-nowrap justify-center gap-8 xl:gap-10">
      {columns.map((column) => (
        <div
          class:list={[
            "flex w-[12.5rem] flex-none flex-col gap-6 xl:w-[13.5rem] xl:gap-8",
            column.offset,
          ]}
        >
          {column.includeTitle && (
            <h2 class="text-[26px] font-normal leading-tight text-primary-1 sm:text-[28px] xl:text-[32px]">
              {content.title}
            </h2>
          )}

          {column.images.map((image) => (
            <div
              class:list={[
                "relative overflow-hidden rounded-[28px] shadow-lg shadow-black/15 ring-1 ring-primary-forest/10",
                image.orientation === "portrait" ? "aspect-[3/4]" : "aspect-[4/3]",
              ]}
            >
              <Image
                src={image.source}
                alt={image.alt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                widths={imageWidths}
                sizes={imageSizes}
              />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
