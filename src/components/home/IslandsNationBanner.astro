---
import { Image } from "astro:assets";

import VolcanoBackground from "@assets/img/home/bgVolcano.png";

interface BannerContent {
  title: string;
  paragraphs: string[];
  backgroundAlt: string;
}

const { content } = Astro.props as { content: BannerContent };
const paragraphs = content.paragraphs ?? [];
---

<section class="relative w-full overflow-hidden">
  <div class="absolute inset-0">
    <Image
      src={VolcanoBackground}
      alt={content.backgroundAlt}
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
      sizes="100vw"
      widths={[640, 960, 1280, 1600]}
    />
    <div class="absolute inset-0 bg-primary-forest/70 mix-blend-multiply" aria-hidden="true"></div>
  </div>

  <div class="relative container mx-auto px-4 py-20 sm:py-24 lg:py-32">
    <div class="max-w-3xl text-white flex flex-col gap-6">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light leading-tight">
        {content.title}
      </h2>
      <div class="flex flex-col gap-4 text-base sm:text-lg lg:text-xl font-light">
        {
          paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
