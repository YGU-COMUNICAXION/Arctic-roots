---
import { getImage } from "astro:assets";

interface Props {
  backgroundImage: ImageMetadata;
  align?: "center" | "left";
  showOverlay?: boolean;
  overlayClass?: string;
}

const {
  backgroundImage,
  align = "center",
  showOverlay = true,
  overlayClass = "bg-neutral-950/55",
} = Astro.props as Props;

const sectionAlignmentClasses =
  align === "left" ? "items-start text-left" : "items-center text-center";

const optimzedImage = await getImage({
  src: backgroundImage,
  widths: [400, 800, 1200, 1600, 2000],
  formats: ["avif", "webp", "jpeg"],
  quality: 80,
});
---

<section
  class={`relative w-full h-[80vh] md:h-[80vh] lg:h-[90vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 overflow-hidden ${sectionAlignmentClasses}`}
  style={`background-image: url(${optimzedImage.src}); background-size: cover; background-position: center;`}
>
  {showOverlay && (
    <div class={`absolute inset-0 ${overlayClass}`} aria-hidden="true"></div>
  )}
  <main class={`relative z-10 flex flex-col gap-6`}>
    <slot />
  </main>
</section>
