---
import HeroBanner from "@components/HeroBanner.astro";
import { getImage } from "astro:assets";

import type { UILang } from "@i18n/ui";
import { ui } from "@i18n/ui";
import { useTranslatedPath } from "@i18n/utils";

import HeroBackground from "@assets/img/travels/hero.jpg";
import GroupCardImage from "@assets/img/travels/viajeGrupal.png";
import PrivateCardImage from "@assets/img/travels/viajePrivado.png";
import SelfGuidedCardImage from "@assets/img/travels/viajeAutoguiado.png";
import CalendarBackground from "@assets/img/travels/bgOtonio.jpg";
import TravelCalendarSection from "./TravelCalendarSection.astro";

interface Props {
  lang: UILang;
}

const { lang } = Astro.props as Props;
const content = ui[lang].travelTypes;

const useTranslate = useTranslatedPath(lang);

const groupCardBackground = await getImage({
  src: GroupCardImage,
  widths: [600, 900],
  formats: ["avif", "webp", "jpeg"],
  quality: 85,
});

const privateCardBackground = await getImage({
  src: PrivateCardImage,
  widths: [600, 900],
  formats: ["avif", "webp", "jpeg"],
  quality: 85,
});

const selfGuidedCardBackground = await getImage({
  src: SelfGuidedCardImage,
  widths: [600, 900],
  formats: ["avif", "webp", "jpeg"],
  quality: 85,
});

const cardBackgrounds = {
  group: groupCardBackground,
  private: privateCardBackground,
  selfGuided: selfGuidedCardBackground,
} as const;
---

<HeroBanner backgroundImage={HeroBackground}>
  <div
    class="flex flex-col items-center gap-6 max-w-5xl
   text-white lg:pt-12 xl:pt-16"
  >
    <h1
      class="text-2xl md:text-3xl lg:text-4xl font-semibold leading-tight text-center"
    >
      {content.hero.title}
    </h1>
    <p
      class="max-w-3xl text-base md:text-lg lg:text-xl text-center font-light text-white/90"
    >
      {content.hero.description}
    </p>
    <div class="flex flex-col items-center gap-0">
      <a
        href={`#${content.calendar.anchorId}`}
        class="group flex flex-col items-center gap-3 text-base md:text-lg font-medium text-white transition-colors
        hover:text-primary-mist focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70
        focus-visible:ring-offset-2 focus-visible:ring-offset-black/40"
        aria-label={content.hero.ctaAriaLabel}
      >
        <span>{content.hero.ctaLabel}</span>
        <svg
          class="w-10 transition-transform duration-200 group-hover:translate-y-1"
          width="69"
          height="69"
          viewBox="0 0 69 69"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M51.75 25.875L34.5 43.125L17.25 25.875"
            stroke="#DEDCD1"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <p
        class="max-w-base text-center text-xs md:text-sm font-light text-white/70"
      >
        {content.hero.disclaimer}
      </p>
    </div>
  </div>
</HeroBanner>

<section class="mt-16 lg:mt-24 bg-white">
  <div
    class="container mx-auto px-4 md:px-8 lg:px-12
  flex flex-col items-center"
  >
    <div class="grid gap-8 lg:grid-cols-3 mb-8 lg:mb-12">
      {
        content.cardsSection.cards.map(
          (card: {
            type: keyof typeof cardBackgrounds;
            title: string;
            subtitle: string;
            badge?: string;
            detailsHtml: string;
            note?: string;
          }) => (
            <article
              class="relative overflow-hidden rounded-[18px] text-white shadow-2xl shadow-black/40 border border-white/15 flex flex-col min-h-[24rem] md:min-h-[26rem]"
              style={`background-image: url(${cardBackgrounds[card.type].src}); background-size: cover; background-position: center;`}
            >
              <div
                class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/60 to-black/80"
                aria-hidden="true"
              />

              <div class="relative z-10 flex flex-1 flex-col p-6 md:p-8">
                <div class="flex items-start justify-between gap-4 mb-4">
                  <div class="space-y-3">
                    <h3 class="text-2xl xl:text-4xl font-semibold leading-tight">
                      {card.title}
                    </h3>
                  </div>

                  {card.badge && (
                    <span
                      class="inline-flex items-center rounded-lg bg-[#DEDCD1]/95
                    px-2.5 py-0.5 text-base lg:text-lg font-light text-primary-forest/90 backdrop-blur-sm"
                    >
                      {card.badge}
                    </span>
                  )}
                </div>
                <p class="text-sm md:text-base font-light text-white/85">
                  {card.subtitle}
                </p>

                <div class="mt-6 flex-1">
                  <div
                    class="text-sm md:text-base font-light text-white/85 space-y-4"
                    set:html={card.detailsHtml}
                  />
                </div>

                {card.note && (
                  <p class="mt-auto pt-6 text-xs md:text-sm font-light text-white/70">
                    {card.note}
                  </p>
                )}
              </div>
            </article>
          )
        )
      }
    </div>

    <p
      class="max-w-lg text-primary-forest text-center
    font-light text-lg md:text-xl lg:text-2xl xl:text-3xl"
    >
      {content.cardsSection.contactCta.ctaTitle}
    </p>

    <div class="mt-4 flex justify-center mb-16 lg:mb-24">
      <a
        hnslate("
        contact")}
        class="inline-flex items-center justify-center gap-3 rounded-full
        bg-primary-mist px-8 py-2 font-normal uppercase tracking-wide text-primary-forest
        shadow-lg shadow-black/20 transition-transform
        hover:-translate-y-0.5 focus-visible:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-100/70"
      >
        {content.cardsSection.contactCta.label}
      </a>
    </div>
  </div>

  <div class="flex flex-col items-center text-center text-primary-forest">
    <p class="text-base md:text-lg lg:text-2xl font-light">
      {content.calendar.prompt}
    </p>
    <svg
      class="w-12 transition-transform duration-200"
      width="40"
      height="40"
      viewBox="0 0 69 69"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M51.75 25.875L34.5 43.125L17.25 25.875"
        stroke="#2e5654"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</section>

<TravelCalendarSection
  id={content.calendar.anchorId}
  backgroundImage={CalendarBackground}
  prompt={content.calendar.prompt}
  heading={content.calendar.heading}
  dateLabel={content.calendar.date}
  description={content.calendar.description}
  includesTitle={content.calendar.includesTitle}
  includes={[...content.calendar.includes]}
  routeTitle={content.calendar.routeTitle}
  timeline={[...content.calendar.timeline]}
  placesTitle={content.calendar.placesTitle}
  priceLabel={content.calendar.priceLabel}
  price={content.calendar.price}
/>
