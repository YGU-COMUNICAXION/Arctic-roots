---
import type { ImageMetadata } from "astro";

interface TimelineEntry {
  dates: string;
  place: string;
}

interface Props {
  id: string;
  backgroundImage: ImageMetadata;
  heading: string;
  dateLabel: string;
  description: string;
  includesTitle: string;
  includes: string[];
  routeTitle: string;
  timeline: TimelineEntry[];
  placesTitle: string;
  priceLabel: string;
  price: string;
}

const {
  id,
  backgroundImage,
  heading,
  dateLabel,
  description,
  includesTitle,
  includes,
  routeTitle,
  timeline,
  placesTitle,
  priceLabel,
  price,
} = Astro.props as Props;

const [headingPrimary, headingSecondary] = heading.includes("|")
  ? heading.split("|").map((part) => part.trim())
  : [heading, ""];
---

<section
  id={id}
  class="relative py-20 md:py-28"
  style={`background-image: url(${backgroundImage.src}); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
  <div class="relative z-10 container px-4 md:px-8 lg:px-12 flex flex-col gap-8 text-white">
    <div class="flex flex-wrap items-center justify-between gap-4 text-white">
      <h3 class="text-2xl md:text-3xl font-semibold tracking-tight">
        <span>{headingPrimary}</span>
        {headingSecondary && <span class="font-light"> | {headingSecondary}</span>}
      </h3>
      <div class="inline-flex items-center rounded-full bg-primary-mist px-6 py-2 text-xs font-medium uppercase tracking-[0.2em] text-primary-forest shadow-lg shadow-black/20 md:text-sm">
        {dateLabel}
      </div>
    </div>

    <div class="overflow-hidden rounded-[30px] border border-white/15 bg-white/8 backdrop-blur-2xl text-white shadow-xl">
      <div class="flex flex-col gap-10 p-8 md:p-12">
        <p class="text-sm md:text-base font-light leading-relaxed text-white/90">
          {description}
        </p>

        <div class="grid gap-10 md:grid-cols-[0.6fr_0.2fr_0.2fr]">
          <div class="space-y-4">
            <h4 class="text-base font-semibold text-white/90">{includesTitle}</h4>
            <ul class="list-disc space-y-2 pl-5 text-sm md:text-base font-light text-white/85 marker:text-primary-mist">
              {includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="space-y-4">
            <h4 class="text-base font-semibold text-white/90">{routeTitle}</h4>
            <ul class="route-list space-y-5 text-sm md:text-base font-light text-white/90">
              {timeline.map((entry) => (
                <li>
                  <span class="block">{entry.dates}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-5 pt-[1.95rem] md:pt-9">
            <ul class="space-y-5 text-sm md:text-base font-light text-white/85" aria-label={placesTitle}>
              {timeline.map((entry) => (
                <li>{entry.place}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center text-sm md:text-base font-light text-white/80">
      <span>{priceLabel}</span>
      <span class="ml-2 text-lg md:text-2xl font-semibold text-white">{price}</span>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .route-list li {
    position: relative;
    padding-left: 1.75rem;
  }

  .route-list li::before {
    content: "";
    position: absolute;
    left: 0.35rem;
    top: 0.45rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .route-list li::after {
    content: "";
    position: absolute;
    left: 0.55rem;
    top: 1.1rem;
    height: calc(100% + 1.25rem);
    border-left: 1px dashed rgba(255, 255, 255, 0.3);
  }

  .route-list li:last-child::after {
    display: none;
  }
</style>
